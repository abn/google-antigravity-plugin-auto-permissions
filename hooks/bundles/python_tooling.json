{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "python-tooling",
  "description": "Standard Python test, lint, and packaging tools (pytest, ruff, black, flake8, mypy, uv, poetry)",
  "version": "1.0.0",
  "allow": [
    "command(pytest*)",
    "command(python -m pytest*)",
    "command(python3 -m pytest*)",
    "command(uv run pytest*)",
    "command(uv run --frozen pytest*)",
    "command(ruff check*)",
    "command(ruff format*)",
    "command(black*)",
    "command(flake8*)",
    "command(mypy*)",
    "command(uv lock*)",
    "command(uv sync*)",
    "command(poetry run *)",
    "command(poetry check*)",
    "command(poetry lock*)",
    "command(poetry show*)",
    "command(poetry install*)"
  ]
}
